(include "./widgets.yuck")

(defwindow bar0
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%"
                      :y "10px"
		      :width "100%"
		      :height "30px"
		      :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :visible false 
  (bar :monitorId 0))

(defwindow bar1
  :monitor 1
  :windowtype "dock"
  :geometry (geometry :x "0%"
                      :y "0px"
		      :width "100%"
		      :height "30px"
		      :anchor "bottom center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :monitorId 1))
